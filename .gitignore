# Spec Kit machine-local state is already ignored via .specify/.gitignore
.claude/settings.local.json
.DS_Store

# Java / Maven build output and IDE files
target/
*.class
*.iml
.idea/
.vscode/

# Local-only test harness (not a deliverable)
local-ui/

# Spec Kit / Claude Code tooling: installed locally by `specify init`, not part of the submission.
